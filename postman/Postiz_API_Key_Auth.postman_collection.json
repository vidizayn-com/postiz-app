{
  "info": {
    "name": "Postiz API Key Authentication",
    "description": "Collection for testing Postiz API Key Authentication endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "postiz-api-key-auth-collection",
    "version": {
      "major": 1,
      "minor": 0,
      "patch": 0
    }
  },
  "item": [
    {
      "name": "API Key Authentication",
      "item": [
        {
          "name": "Register with API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.apiKey) {",
                  "        pm.environment.set('api_key', response.apiKey.key);",
                  "        pm.environment.set('user_id', response.user.id);",
                  "        pm.environment.set('organization_id', response.organization.id);",
                  "        console.log('API Key saved to environment:', response.apiKey.key.substring(0, 20) + '...');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"provider\": \"LOCAL\",\n  \"company\": \"{{test_company}}\",\n  \"keyName\": \"{{api_key_name}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/api-key/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "api-key",
                "register"
              ]
            },
            "description": "Register a new user and receive an API key. If a user with the provided email already exists, this endpoint will behave like a login instead of throwing an error, validating the registration token and creating a new API key for the existing user. The 'password' field should contain the API_KEY_REGISTRATION_TOKEN from your environment variables."
          },
          "response": [
            {
              "name": "Successful Registration",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"provider\": \"LOCAL\",\n  \"company\": \"My Company\",\n  \"keyName\": \"My API Key\",\n  \"expiresInDays\": 30\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/api-key/register",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
                    "api-key",
                    "register"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"apiKey\": {\n    \"id\": \"uuid\",\n    \"name\": \"My API Key\",\n    \"key\": \"postiz_live_abcd1234...\",\n    \"expiresAt\": \"2024-02-01T00:00:00Z\",\n    \"isActive\": true,\n    \"createdAt\": \"2024-01-01T00:00:00Z\"\n  },\n  \"user\": {\n    \"id\": \"uuid\",\n    \"email\": \"user@example.com\",\n    \"name\": \"John Doe\"\n  },\n  \"organization\": {\n    \"id\": \"uuid\",\n    \"name\": \"My Organization\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Login with API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.apiKey) {",
                  "        pm.environment.set('api_key', response.apiKey.key);",
                  "        console.log('New API Key saved to environment:', response.apiKey.key.substring(0, 20) + '...');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"provider\": \"LOCAL\",\n  \"keyName\": \"{{api_key_name}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/api-key/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "api-key",
                "login"
              ]
            },
            "description": "Login with existing user credentials and receive a new API key. This endpoint validates user credentials and generates a new API key for authentication."
          },
          "response": [
            {
              "name": "Successful Login",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"provider\": \"LOCAL\",\n  \"keyName\": \"My API Key\",\n  \"expiresInDays\": 30\n}"
                },
                "url": {
                  "raw": "{{base_url}}/auth/api-key/login",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "auth",
                    "api-key",
                    "login"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"apiKey\": {\n    \"id\": \"uuid\",\n    \"name\": \"My API Key\",\n    \"key\": \"postiz_live_abcd1234...\",\n    \"expiresAt\": \"2024-02-01T00:00:00Z\",\n    \"isActive\": true,\n    \"createdAt\": \"2024-01-01T00:00:00Z\"\n  },\n  \"user\": {\n    \"id\": \"uuid\",\n    \"email\": \"user@example.com\",\n    \"name\": \"John Doe\"\n  },\n  \"organization\": {\n    \"id\": \"uuid\",\n    \"name\": \"My Organization\"\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Protected API Endpoints (Using API Key)",
      "item": [
        {
          "name": "Test API Key - Get Posts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{api_key}}",
                "description": "API Key for authentication"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "posts"
              ]
            },
            "description": "Test the generated API key by fetching posts. This endpoint requires a valid API key in the Authorization header."
          },
          "response": []
        },
        {
          "name": "Test API Key - Get Integrations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{api_key}}",
                "description": "API Key for authentication"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/integrations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "integrations"
              ]
            },
            "description": "Test the generated API key by fetching integrations. This endpoint requires a valid API key in the Authorization header."
          },
          "response": []
        },
        {
          "name": "Test API Key - Create Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{api_key}}",
                "description": "API Key for authentication"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello World from Postman! 🚀\",\n  \"integrations\": []\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "posts"
              ]
            },
            "description": "Test the generated API key by creating a new post. This endpoint requires a valid API key in the Authorization header."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "description": "Base URL for the Postiz API"
    },
    {
      "key": "test_email",
      "value": "test@example.com",
      "description": "Test email for authentication"
    },
    {
      "key": "test_password",
      "value": "password123",
      "description": "Test password for authentication"
    },
    {
      "key": "test_company",
      "value": "Test Company",
      "description": "Company name for registration"
    },
    {
      "key": "api_key_name",
      "value": "Test API Key",
      "description": "Name for the API key"
    },
    {
      "key": "expires_in_days",
      "value": "30",
      "description": "Number of days until API key expires (1-365) - Optional, remove from request body for non-expiring keys"
    }
  ]
}
